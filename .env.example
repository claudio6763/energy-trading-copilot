# Copie para .env e ajuste. Sem ANTHROPIC_API_KEY a aplicacao inicia em modo demonstracao.

# Chave da API Anthropic. Deixe vazia para rodar em MODO DEMONSTRACAO (sem chamada real).
ANTHROPIC_API_KEY=

# Identificador de modelo valido (ver docs.anthropic.com/en/docs/about-claude/models).
ANTHROPIC_MODEL=claude-sonnet-5

# "live" = forca IA real (exige ANTHROPIC_API_KEY + SDK instalado).
# "demo" = forca roteiro deterministico mesmo com chave configurada.
# vazio = decide sozinho a partir de ANTHROPIC_API_KEY / DEMO_MODE (compatibilidade).
AI_MODE=live

# Tokens maximos de saida por chamada ao modelo.
AI_MAX_TOKENS=4000

# Temperatura da chamada (0.0 = deterministico, 1.0 = criativo). Mesa de risco: manter baixo.
AI_TEMPERATURE=0.2

# Timeout por chamada ao modelo, em segundos.
AI_TIMEOUT_SECONDS=60

# true = ao surgir alerta CRITICO do Watchdog, o debate da tese afetada roda de novo
# automaticamente (ainda sem intervencao humana — RNF "Watchdog nunca depende de acao humana").
AI_AUTO_REVIEW_ON_ALERT=false

# Retrocompatibilidade (usadas se AI_MODE/AI_MAX_TOKENS nao estiverem definidas).
LLM_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=4000

# true = agentes usam roteiro deterministico (nao e IA). false + chave = IA real.
# Ignorado quando AI_MODE esta definido.
DEMO_MODE=true

# Corte oficial do case. A tese oficial nao pode usar dado posterior.
DATA_CUT_OFF=2026-08-14

# Limite de VaR da mesa (tambem gravado na tabela risk_limits).
VAR_LIMIT_BRL=50000000.00

# Caminho do banco. Deixe vazio para usar data/copilot.db.
# Em pasta de rede/OneDrive o SQLite pode falhar: aponte para um disco local.
COPILOT_DB=

# ---------------------------------------------------------------------------
# Conexoes de dados do setor eletrico — ver docs/CONEXOES_DADOS_SETOR.md
# ---------------------------------------------------------------------------

# ONS, CCEE e EPE sao publicas, sem autenticacao (PUBLIC_NO_AUTH) e nao
# precisam de nenhuma variavel abaixo para funcionar.

# EPE nao tem API: o link do XLSX de consumo mensal e descoberto na pagina
# oficial. Sobrescreva so se o layout da pagina mudar e a descoberta falhar.
EPE_CONSUMO_URL=

# Timeout padrao (segundos) dos conectores HTTP.
HTTP_TIMEOUT_SECONDS=30
MARKET_DATA_USER_AGENT=EnergyTradingCopilot/1.0

# BBCE — curva forward licenciada (OPTIONAL_LICENSED). Exige plano pago e
# cadastro manual no portal do desenvolvedor (https://portaldodesenvolvedor.bbce.com.br/).
# Desligado por padrao; sem estas quatro variaveis o conector nunca chama a rede.
BBCE_API_ENABLED=false
BBCE_API_BASE_URL=
BBCE_API_KEY=
BBCE_AUTH_TOKEN=
