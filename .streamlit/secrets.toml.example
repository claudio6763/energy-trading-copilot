# Cole isto (com os valores reais) em: Streamlit Cloud -> seu app -> Settings
# -> Secrets. NUNCA commite secrets.toml de verdade — este arquivo é só o
# modelo, com placeholders, e é seguro de versionar.
#
# Local: copie para .streamlit/secrets.toml (esse sim gitignored) se quiser
# testar o app localmente contra o Postgres em vez do .env/COPILOT_DB.

# Postgres gerenciado (Neon/Supabase). psycopg puro — aceita tanto
# "postgresql://..." quanto "postgresql+psycopg://..." (o código normaliza).
DATABASE_URL = "postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Opcional — sem ela o app roda em modo demonstração (nunca apresentado como IA real).
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5"
